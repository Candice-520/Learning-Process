#include <iostream>
#include<ctime>
using std::cout;
using std::cin;
using std::endl;

int main()
{   
	srand ((unsigned)time(NULL));
	int a = rand() % 100 + 1;
	int b = 0;
	cout << "请输入一个1到100的整数：" << endl;
	while (1)
	{
		cin >> b;
		if (b > a)
			cout << "您猜大了，请重新猜" << endl;
		else if (b < a)
			cout << "您猜小了，请重新猜" << endl;
		else
		{
			cout << "恭喜你，猜对了！" << endl;
			break;
		}
	}
	
	system("pause");
	return 0;
}
