#include<iostream>
using namespace std;
int main()
{
	cout << "水仙花数为：" << endl;
	int a = 1;
	int b = 0;
	int c = 0;
	
	do {
		if ((a * a * a + b * b * b + c * c * c) == (a * 100 + b * 10 + c * 1))
			cout << a << b << c << endl;
		c++;
		if (c <= 10)
			continue;
		else
		{
			c = 0;
			b++;
			if(b<=10)
				continue;
			else
			{
				b = 0;
				a++;
			}
		}
	} while ((a * 100 + b * 10 + c * 1) < 1000);
	system("pause");
	return 0;
}
