#include<iostream>
using namespace std;
int main()
{
	int arr[5] = {};
	for (int a = 1;a < 6;a++)
	{
		cout << "请输入第" << a << "只小猪的体重：" << endl;
		cin >> arr[a - 1];
	}
	int max = arr[0];
	for (int i = 0;i < 5;i++)
	{
		if (arr[i] > max)
			max = arr[i];
	}
	cout << "最重的小猪为：" << max << endl;
	system("pause");
	return 0;
}
