#include<iostream>
using namespace std;
int main()
{
	int arr[5] = {};
	for (int a = 1;a < 6;a++)
	{
		cout << "请输入第" << a << "只小猪的体重：" << endl;
		cin >> arr[a - 1];
	}
	for (int i = 0;i < 5 - 1;i++)
	{
		if (arr[i] > arr[i + 1])
		{
			int temp = arr[i];
			arr[i] = arr[i + 1];
			arr[i + 1] = temp;
		}
	}
	cout << "最重的小猪为：" << arr[4] << endl;
	system("pause");
	return 0;
}
