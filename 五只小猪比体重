#include<iostream>
using namespace std;
int main()
{
	int arr[5] = {};
	for (int a = 1;a < 6;a++)
	{
		cout << "请输入第" << a << "只小猪的体重：" << endl;
		cin >> arr[a - 1];
	}
	cout << "小猪的体重排序为：" << endl;
	for(int i=0;i<5-1;i++)
	{
		for (int j = 0;j<5-i-1;j++)
		{ if(arr[j]>arr[j+1])
		  {
			int temp = arr[j];
			arr[j] = arr[j+1];
			arr[j+1] = temp;
		  }
		}
	}
	for (int t = 0;t < 5;t++)
		cout << arr[t] << "\t";
	system("pause");
	return 0;
}
